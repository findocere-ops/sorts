{
  "address": "AEp6VuJqfctTRQpZP3LDjKcua4C1jGP8YT721AMSBkFV",
  "metadata": {
    "name": "sorts_community",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "SORTS private subscription rails — Solana program (Quasar). Hand-written IDL: quasar-cli IDL gen returns Anyhow error on the pinned revision."
  },
  "discriminatorEncoding": "single-byte",
  "_notes": [
    "Discriminators are SINGLE bytes — Quasar uses #[instruction(discriminator = N)] / #[account(discriminator = N)], not Anchor's 8-byte sighash. The default Anchor TS client will not work without a custom coder. SolanaService hand-builds instruction data and hand-decodes account data.",
    "All Pubkey-typed fields are 32 bytes, no padding. Account layout uses natural Rust order; #[repr(C)] is not declared, so the compiler may reorder for alignment — verify with a real on-chain fetch before depending on offsets in client code."
  ],
  "instructions": [
    {
      "name": "initializeCommunity",
      "discriminator": [0],
      "accounts": [
        { "name": "creator", "writable": true, "signer": true },
        { "name": "community", "writable": true, "pda": { "seeds": [{ "kind": "const", "value": [99, 111, 109, 109, 117, 110, 105, 116, 121] }, { "kind": "account", "path": "creator" }] } },
        { "name": "clock", "address": "SysvarC1ock11111111111111111111111111111111" },
        { "name": "rent", "address": "SysvarRent111111111111111111111111111111111" },
        { "name": "systemProgram", "address": "11111111111111111111111111111111" }
      ],
      "args": [
        { "name": "nameHash", "type": { "array": ["u8", 32] } },
        { "name": "symbolHash", "type": { "array": ["u8", 32] } },
        { "name": "tierCount", "type": "u8" },
        { "name": "tier1PriceLamports", "type": "u64" },
        { "name": "tier1DurationSecs", "type": "i64" },
        { "name": "tier2PriceLamports", "type": "u64" },
        { "name": "tier2DurationSecs", "type": "i64" },
        { "name": "tier3PriceLamports", "type": "u64" },
        { "name": "tier3DurationSecs", "type": "i64" }
      ]
    },
    {
      "name": "subscribe",
      "discriminator": [1],
      "accounts": [
        { "name": "subscriber", "writable": true, "signer": true },
        { "name": "community", "writable": true },
        { "name": "subscription", "writable": true, "pda": { "seeds": [{ "kind": "const", "value": [115, 117, 98, 115, 99, 114, 105, 112, 116, 105, 111, 110] }, { "kind": "account", "path": "community" }, { "kind": "account", "path": "subscriber" }] } },
        { "name": "protocolTreasury", "writable": true },
        { "name": "creator", "writable": true },
        { "name": "clock", "address": "SysvarC1ock11111111111111111111111111111111" },
        { "name": "rent", "address": "SysvarRent111111111111111111111111111111111" },
        { "name": "systemProgram", "address": "11111111111111111111111111111111" }
      ],
      "args": [
        { "name": "level", "type": "u8" },
        { "name": "saltPubkey", "type": "pubkey" }
      ]
    },
    {
      "name": "renewSubscription",
      "discriminator": [2],
      "accounts": [
        { "name": "subscriber", "writable": true, "signer": true },
        { "name": "community", "writable": true },
        { "name": "subscription", "writable": true },
        { "name": "protocolTreasury", "writable": true },
        { "name": "creator", "writable": true },
        { "name": "clock", "address": "SysvarC1ock11111111111111111111111111111111" },
        { "name": "systemProgram", "address": "11111111111111111111111111111111" }
      ],
      "args": [
        { "name": "level", "type": "u8" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "Community",
      "discriminator": [1],
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "creator", "type": "pubkey" },
          { "name": "nameHash", "type": { "array": ["u8", 32] } },
          { "name": "symbolHash", "type": { "array": ["u8", 32] } },
          { "name": "createdAt", "type": "i64" },
          { "name": "tierCount", "type": "u8" },
          { "name": "tier1PriceLamports", "type": "u64" },
          { "name": "tier1DurationSecs", "type": "i64" },
          { "name": "tier2PriceLamports", "type": "u64" },
          { "name": "tier2DurationSecs", "type": "i64" },
          { "name": "tier3PriceLamports", "type": "u64" },
          { "name": "tier3DurationSecs", "type": "i64" },
          { "name": "totalMembersCounter", "type": "u64" },
          { "name": "activeMembersCounter", "type": "u64" },
          { "name": "totalRevenueLamports", "type": "u64" },
          { "name": "bump", "type": "u8" }
        ]
      }
    },
    {
      "name": "Subscription",
      "discriminator": [3],
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "community", "type": "pubkey" },
          { "name": "subscriber", "type": "pubkey" },
          { "name": "expiryTs", "type": "i64" },
          { "name": "tierCommitment", "type": { "array": ["u8", 32] } },
          { "name": "saltPubkey", "type": "pubkey" },
          { "name": "bump", "type": "u8" }
        ]
      }
    }
  ],
  "errors": [
    { "code": 8192, "name": "InvalidTierCount", "msg": "Tier count must be 1..=3" },
    { "code": 8193, "name": "InvalidTierLevel", "msg": "Tier level must match a configured tier" },
    { "code": 8194, "name": "Underpaid", "msg": "Insufficient payment for tier price" },
    { "code": 8195, "name": "AlreadySubscribed", "msg": "Subscription already active for this community" },
    { "code": 8196, "name": "NoSubscription", "msg": "No subscription to renew" },
    { "code": 8197, "name": "MathOverflow", "msg": "Arithmetic overflow" },
    { "code": 8198, "name": "UnauthorizedTreasury", "msg": "Protocol treasury account does not match PROTOCOL_TREASURY" },
    { "code": 8199, "name": "UnauthorizedCreator", "msg": "Creator account does not match community.creator" },
    { "code": 8200, "name": "InvalidCommunity", "msg": "Account belongs to a different community" }
  ]
}
