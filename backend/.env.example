# SORTS backend environment template
# Copy to backend/.env and fill in. Never commit real values.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_PATH=./data/sorts.db

# ── Solana (Phase 2 — primary chain) ───────────────────────────────────────
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=

# ── Privy (server-side identity verification) ──────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Umbra Privacy SDK (experimental) ───────────────────────────────────────
UMBRA_NETWORK=solana-devnet
UMBRA_INDEXER_URL=

# ── IKA dWallet (pre-alpha) ────────────────────────────────────────────────
IKA_API_URL=

# ── Telegram bot ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── iExec DataProtector (optional content protection) ──────────────────────
IEXEC_PRIVATE_KEY=
IEXEC_SORTS_IAPP_ADDRESS=

# ── Arbitrum legacy adapter (kept buildable, not the launch path) ──────────
ARBITRUM_SEPOLIA_RPC_URL=
SORTS_FACTORY_ADDRESS=

# ── Feature flags ──────────────────────────────────────────────────────────
ENABLE_SOLANA_PHASE2=true
ENABLE_UMBRA_ENCRYPTED_BALANCES=false
ENABLE_UMBRA_MIXER=false
ENABLE_IKA_DWALLET=false
ENABLE_IKA_REAL_FUNDS=false
ENABLE_REAL_FHE=false
ENABLE_REAL_MPC_SIGNING=false

# Tier 1.3 — Cloak private payment rail.
# Cloak's program is mainnet-only as of 2026-05-07. Devnet builds keep this
# false; flipping to true on a devnet deploy has no effect (no Cloak program
# at the address). Mainnet activation requires the cron verifier service per
# docs/SUBMISSION_RISKS.md R2.
ENABLE_CLOAK_MAINNET=false
