# SORTS frontend environment template
# Copy to frontend/.env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle.

# ── Required ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# Demo mode: set to "true" only when running without a real Privy app id.
# Production builds with no PRIVY_APP_ID and demo mode off will refuse to start.
NEXT_PUBLIC_DEMO_MODE=false

# ── Privy ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Solana (Phase 2 — primary chain) ────────────────────────────────────────
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_PROGRAM_ID=

# ── Site / metadata ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Arbitrum legacy adapter (kept buildable, not the demo path) ─────────────
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SORTS_FACTORY_ADDRESS=
