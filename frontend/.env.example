# SORTS frontend environment template
# Copy to frontend/.env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle.

# ── Required ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# Demo mode: set to "true" only when running without a real Privy app id.
# Production builds with no PRIVY_APP_ID and demo mode off will refuse to start.
NEXT_PUBLIC_DEMO_MODE=false

# ── Privy ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Solana (Phase 2 — primary chain) ────────────────────────────────────────
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_PROGRAM_ID=

# ── Cloak private payment rail (Tier 1.3 — MAINNET ONLY) ────────────────────
# Cloak's program is mainnet-only as of 2026-05-07. Devnet builds keep this
# false; the dual-path subscribe ix records all-zero `cloak_payment_sigs` and
# the on-chain handler executes the legacy transparent payment flow. Flipping
# to true on devnet has no effect (no Cloak program at the address); flipping
# on a mainnet deploy without the v2 cron verifier service is unsafe (see
# docs/SUBMISSION_RISKS.md R2).
NEXT_PUBLIC_ENABLE_CLOAK_MAINNET=false

# ── Site / metadata ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Arbitrum legacy adapter (kept buildable, not the demo path) ─────────────
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SORTS_FACTORY_ADDRESS=
